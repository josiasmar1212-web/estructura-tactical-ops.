# CABECERA
st.markdown('<div class="main-title">ESTRUTURA: TACTICAL OPS v1.0</div>', unsafe_allow_html=True)

# LÓGICA DE NEGOCIO
col1, col2 = st.columns(2)

with col1:
    st.subheader("📋 INGRESO DE MARCAS")
    with st.form("puntos_form"):
        genero = st.radio("Género", ["Masculino", "Femenino"])
        circuito = st.number_input("Circuito Agilidad (seg)", 7.0, 15.0, 10.0)
        dominadas = st.slider("Dominadas / Suspensión", 0, 20, 10)
        carrera = st.number_input("1000m (segundos totales)", 180, 300, 210)
        
        btn = st.form_submit_button("CALCULAR APTITUD")

with col2:
    if btn:
        st.markdown('<div class="card">', unsafe_allow_html=True)
        # Cálculo rápido (Baremos simplificados para el test)
        puntos = (11 - (circuito - 7)) + (dominadas * 0.5)
        total = round(max(0, puntos), 1)
        
        st.write("### RESULTADO OFICIAL")
        st.title(f"{total} PUNTOS")
        
        if total >= 15:
            st.success("ESTADO: APTO")
        else:
            st.error("ESTADO: NO APTO")
        st.markdown('</div>', unsafe_allow_html=True)
    else:
        st.info("Esperando datos del operador para análisis táctico...")

